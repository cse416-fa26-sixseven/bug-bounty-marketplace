# Copy to .env (git-ignored) and fill in. Every value is optional except the
# database and storage settings, which the worker needs to do anything.

# Shared with the API: same Postgres and the same source storage. Locally
# that is a directory; on AKS it is the Blob container the API writes to
# (SOURCE_STORAGE_BLOB_CONTAINER_URL=https://<account>.blob.core.windows.net/sources,
# read with the pod's workload identity), which wins over the directory.
DATABASE_URL=postgres://bbm:bbm@localhost:5432/bbm
SOURCE_STORAGE_DIR=../../.data/storage
SOURCE_STORAGE_BLOB_CONTAINER_URL=

# LLM (OpenAI-compatible chat completions, e.g. Azure AI Foundry).
# Format: https://<resource>.services.ai.azure.com/openai/v1
# Leave LLM_API_KEY empty to skip the LLM; explanations then use Slither's text.
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=
# Reasoning models (e.g. Grok 4.x) take ~20-30s per contract; analysis runs in
# the background, so the default is generous.
LLM_TIMEOUT_SECONDS=90

# Worker tuning (defaults shown).
POLL_INTERVAL_SECONDS=1
JOB_LEASE_SECONDS=600
JOB_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=2

# Sandbox (defaults shown). SANDBOX_ENABLED=true also claims sandbox jobs.
SANDBOX_IMAGE=bbm-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=120
CHALLENGE_WINDOW_SECONDS=86400
# docker (the Compose overlay, Docker socket) or kubernetes (AKS: one Job per
# PoC). The kubernetes backend needs SANDBOX_NAMESPACE and the Job template
# the Helm chart mounts at SANDBOX_JOB_TEMPLATE; the chart sets all three.
SANDBOX_BACKEND=docker
SANDBOX_NAMESPACE=
SANDBOX_JOB_TEMPLATE=/etc/bbm/sandbox/job.yaml
