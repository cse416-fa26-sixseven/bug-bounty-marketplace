{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "address": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "stake": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d{0,77})$"
    },
    "reputation": {
      "type": "number"
    },
    "claimedContractIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pendingPayout": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d{0,77})$"
    },
    "activeSubmissions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "address",
    "stake",
    "reputation",
    "claimedContractIds"
  ],
  "additionalProperties": false
}
