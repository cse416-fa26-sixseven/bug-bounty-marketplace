{
  "name": "bug-bounty-marketplace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm --filter @bbm/web dev",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down -v",
    "stack:ci": "docker compose -f docker-compose.yml -f docker-compose.ci.yml up -d --wait --no-build db api web analysis anvil",
    "stack:deploy-contracts": "docker compose run --rm contracts-deploy",
    "stack:demo": "bash scripts/demo-stack.sh",
    "demo:lifecycle": "bash scripts/demo-lifecycle.sh",
    "demo:prep": "bash scripts/demo-prep.sh",
    "test:integration": "pnpm --filter @bbm/system-tests run test:integration",
    "test:regression": "pnpm --filter @bbm/system-tests run test:regression",
    "test:smoke": "pnpm --filter @bbm/system-tests run test:smoke",
    "test:e2e": "pnpm --filter @bbm/system-tests run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
