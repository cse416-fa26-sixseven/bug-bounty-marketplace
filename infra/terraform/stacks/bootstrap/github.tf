# Builds the `gh` CLI commands that wire this subscription into the GitHub
# repo (repo variables, Environments + branch policies, per-env client IDs).
# Nothing here is secret: OIDC means only IDs are stored in GitHub.

locals {
  # GitHub Environment => OIDC identity, reviewer requirement, main-only.
  github_environments = {
    "test"              = { identity = "gh-bbm-ephemeral", reviewers = false, main_only = false }
    "preview"           = { identity = "gh-bbm-ephemeral", reviewers = false, main_only = false }
    "test-infra"        = { identity = "gh-bbm-test", reviewers = false, main_only = true }
    "infra-global"      = { identity = "gh-bbm-global", reviewers = true, main_only = true }
    "contracts-sepolia" = { identity = "gh-bbm-global", reviewers = true, main_only = false }
    "staging"           = { identity = "gh-bbm-staging", reviewers = false, main_only = true }
    "prod"              = { identity = "gh-bbm-prod", reviewers = true, main_only = true }
    "prod-power"        = { identity = "gh-bbm-prod-power", reviewers = false, main_only = true }
  }

  repo_variables = {
    AZURE_TENANT_ID       = data.azurerm_client_config.current.tenant_id
    AZURE_SUBSCRIPTION_ID = var.subscription_id
    AZURE_PLAN_CLIENT_ID  = module.github_oidc.client_ids["gh-bbm-plan"]
    TFSTATE_RG            = azurerm_resource_group.tfstate.name
    TFSTATE_ACCOUNT       = azurerm_storage_account.tfstate.name
    ACR_NAME              = module.naming.global.acr
  }

  reviewer_list = [for id in var.github_reviewer_ids : { type = "User", id = id }]

  # Reviewer-gated envs with no github_reviewer_ids omit the `reviewers` key so
  # re-running the script never wipes reviewers that were added by hand.
  # Envs that must stay unattended (reviewers = false) always send [].
  env_reviewers = {
    for env, cfg in local.github_environments : env => (
      !cfg.reviewers ? { reviewers = [] } :
      length(local.reviewer_list) > 0 ? { reviewers = local.reviewer_list } : {}
    )
  }

  env_payload = {
    for env, cfg in local.github_environments : env => jsonencode(merge(
      {
        deployment_branch_policy = cfg.main_only ? {
          protected_branches     = false
          custom_branch_policies = true
        } : null
      },
      local.env_reviewers[env],
    ))
  }

  gh_header_lines = concat(
    [
      "#!/usr/bin/env bash",
      "# Generated by infra/terraform/stacks/bootstrap. Requires `gh auth login` as a repo admin.",
    ],
    length(var.github_reviewer_ids) > 0 ? [] : [
      "# NOTE: github_reviewer_ids is empty: add 1 required reviewer to infra-global,",
      "# prod and contracts-sepolia manually (Settings > Environments).",
    ],
    [
      "set -euo pipefail",
      "",
      "# Repo variables (no secrets: Azure auth is OIDC-only)",
    ],
  )

  gh_repo_lines = [
    for k in sort(keys(local.repo_variables)) :
    "gh variable set ${k} --repo ${var.github_repo} --body '${local.repo_variables[k]}'"
  ]

  gh_env_lines = flatten([
    for env in sort(keys(local.github_environments)) : concat(
      [
        "",
        "# --- environment: ${env} (${local.github_environments[env].identity})",
        "echo '${local.env_payload[env]}' | gh api -X PUT repos/${var.github_repo}/environments/${env} --input -",
      ],
      local.github_environments[env].main_only ? [
        "gh api -X POST repos/${var.github_repo}/environments/${env}/deployment-branch-policies -f name=main -f type=branch || true # idempotent re-runs",
      ] : [],
      [
        "gh variable set AZURE_CLIENT_ID --repo ${var.github_repo} --env ${env} --body '${module.github_oidc.client_ids[local.github_environments[env].identity]}'",
      ],
    )
  ])
}
