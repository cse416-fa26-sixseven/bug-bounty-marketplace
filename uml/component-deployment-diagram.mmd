flowchart TB
    subgraph Client["Browser (Developer / Auditor / Arbiter)"]
        UI["Next.js App Router UI<br/>role switcher + mocked wallet"]
        RQ["TanStack Query cache"]
        APIClient["Typed API Client<br/>apps/web/src/lib/api<br/>(.parse() every response)"]
        MSWWorker["MSW Service Worker<br/>(NEXT_PUBLIC_API_MOCKING=enabled)"]
        UI --> RQ --> APIClient
        APIClient -. intercepted in dev .-> MSWWorker
    end

    subgraph MockBackend["Mock Backend (in-browser, Milestone 2)"]
        Handlers["MSW Handlers<br/>handlers/{developer,auditor,arbiter}.ts"]
        MockDB["In-memory Mock DB + Scheduler<br/>db/{contracts,auditors,disputes}.ts"]
        Handlers --> MockDB
    end
    MSWWorker --> Handlers

    subgraph SharedPkg["packages/shared (@bbm/shared)"]
        Zod["Zod schemas + inferred types<br/>Contract, Bounty, Finding, PoCSubmission,<br/>Dispute, AuditorProfile"]
        JSONSchema["Generated JSON Schema<br/>packages/shared/schema/*.json"]
        Zod -- gen:schema --> JSONSchema
    end
    APIClient -.imports types.-> Zod
    Handlers -.imports types.-> Zod

    subgraph RealAPI["apps/api (Fastify) - real backend, partly built"]
        Health["GET /health, POST /api/contracts,<br/>GET /api/contracts/:id + Postgres (implemented)"]
        FutureRoutes["Finding/PoC/Dispute routes<br/>(not yet built - mocked by MSW today)"]
    end
    FutureRoutes -.will replace.-> Handlers
    FutureRoutes -.imports types.-> Zod

    subgraph Workers["workers/ - non-TS services"]
        Analysis["workers/analysis (Python)<br/>container + /health built,<br/>Slither + LLM explanation planned"]
        OtherWorker["future Rust service"]
    end
    Analysis -. datamodel-code-generator .-> JSONSchema
    OtherWorker -. typify .-> JSONSchema
    RealAPI --> Analysis

    subgraph Contracts["contracts/ (Foundry) - on-chain"]
        Escrow["BountyEscrow, AuditorStaking, DisputeResolution<br/>anvil locally, Sepolia via contracts-deploy.yml"]
        PoCTests["Submitted PoC .t.sol tests"]
        Sandbox["Sandbox re-run environment"]
    end
    RealAPI -.will call.-> Escrow
    PoCTests --> Sandbox

    subgraph Compose["Container stack - docker-compose.yml (local + CI)"]
        CWeb["web :3000 (bbm/web)"]
        CApi["api :3001 (bbm/api)"]
        CDb["db :5432 (postgres:16-alpine)"]
        CAnalysis["analysis :8000 (bbm/analysis)"]
        CAnvil["anvil :8545 + contracts-deploy (bbm/contracts)"]
        CWeb -- "/api proxy" --> CApi --> CDb
    end

    subgraph CI["CI - .github/workflows/ci.yml (no Azure credentials)"]
        PathFilter["changes (dorny/paths-filter)"]
        WebJob["web: lint/typecheck/test/build"]
        SharedJob["shared: typecheck/test + gen:schema staleness check"]
        ApiJob["api: lint/typecheck/test/build + Postgres service"]
        ContractsJob["contracts: forge build/test, gas snapshot, Slither"]
        AnalysisJob["analysis: ruff + pytest + model drift"]
        ContainersJob["containers: hadolint, bake images, compose up,<br/>smoke/integration/regression/e2e"]
        TfJob["terraform-static: fmt/validate/tflint/terraform test"]
        HelmJob["helm: lint, kubeconform, ct lint"]
        WfJob["workflows: actionlint"]
        Gate["CI OK (required status check)"]
        PathFilter --> WebJob & SharedJob & ApiJob & ContractsJob & AnalysisJob & ContainersJob & TfJob & HelmJob & WfJob --> Gate
    end
    ContainersJob -. runs .-> Compose

    subgraph Azure["Azure deploy targets - infra/terraform + deploy/helm/bbm (defined, applied after bootstrap)"]
        ACR["ACR bbm/* images (sha-7, pr-N-sha-7)"]
        TestRun["AKS test: CI-run namespace run-ID-ATTEMPT<br/>integration-azure.yml: build, deploy, test, delete"]
        TestPreview["AKS test: PR preview namespace pr-N<br/>preview.yml: per PR, deleted on close"]
        AKSStaging["AKS staging (Helm chart bbm)<br/>deploy.yml + env-power.yml"]
        AKSProd["AKS prod (Helm chart bbm)<br/>deploy.yml, reviewer-gated"]
        ACR --> TestRun & TestPreview & AKSStaging & AKSProd
    end
    Compose -. "same Dockerfiles, pushed by _build-push.yml over OIDC" .-> ACR
    Analysis -. "KEDA queue scaling (planned)" .-> AKSStaging
    Sandbox -. "Kata sandbox pool (planned)" .-> AKSProd

    subgraph Legend["Legend"]
        LCur["built and running in CI"]
        LBuilt["built as IaC / workflows, needs Azure bootstrap"]
        LFut["planned"]
    end

