{
  "name": "@bbm/system-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p demo",
    "test:integration": "vitest run --project integration",
    "test:regression": "vitest run --project regression",
    "test:smoke": "vitest run --project smoke",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "demo": "tsx demo/record.ts"
  },
  "dependencies": {
    "@bbm/shared": "workspace:^",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "viem": "^2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
