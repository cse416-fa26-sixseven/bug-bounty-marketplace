      ],
      "additionalProperties": true
    },
    "ingress": {
      "type": "object",
      "description": "Exposure through the bbm-platform Gateway (HTTPRoute). TLS terminates at the Gateway with the env wildcard certificate.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "pattern": "^$|^([a-z0-9]([-a-z0-9]*[a-z0-9])?\\.)+[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "HTTPRoute hostname (values-infra.yaml or --set). Must fall under one of the Gateway's env-zone listeners."
        },
        "gateway": {
          "type": "object",
          "description": "parentRef of the HTTPRoute: the Gateway from deploy/helm/bbm-platform.",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 63
            },
            "namespace": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 63
            }
          },
          "required": [
            "name",
            "namespace"
          ],
          "additionalProperties": false
        },
        "publicIpName": {
          "type": "string",
          "description": "Ignored by this chart; consumed by bbm-platform (accepted because values-infra.yaml sets it)."
        },
        "publicIpResourceGroup": {
          "type": "string",
          "description": "Ignored by this chart; consumed by bbm-platform."
        }
      },
      "required": [
        "enabled",
        "gateway"
      ],
      "additionalProperties": false
    },
    "postgres": {
      "type": "object",
      "properties": {
        "inCluster": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string",
                  "minLength": 1
                },
                "tag": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "pullPolicy": {
                  "type": "string",
                  "enum": [
                    "",
                    "Always",
                    "IfNotPresent",
                    "Never"
                  ]
                }
              },
              "required": [
                "repository"
              ],
              "additionalProperties": false
            },
            "database": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "user": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "password": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._~-]*$",
              "description": "URL-safe characters only: embedded unescaped in DATABASE_URL."
            },
            "runAsUser": {
              "type": "integer",
              "minimum": 1
            },
            "runAsGroup": {
              "type": "integer",
              "minimum": 1
            },
            "storageSizeLimit": {
              "type": "string"
            },
            "resources": {
              "type": "object",
              "properties": {
                "requests": {
                  "type": "object",
                  "additionalProperties": true
                },
                "limits": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            }
          },
          "required": [
            "enabled",
            "image",
            "database",
            "user"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "restrictEgress": {
          "type": "boolean"
        },
        "postgresCidr": {
          "type": "string",
          "pattern": "^$|^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
